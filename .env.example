# Nightwalk — 12-Factor Runtime Configuration Example
# Copy to $XDG_CONFIG_HOME/nightwalk/env (mode 0600, outside Git) and adjust.

# Loopback browser-pool daemon URL (e.g., vega-browser HTTP API)
NIGHTWALK_BROWSER_URL=http://127.0.0.1:8490

# Browser engine passed to browser pool ("chromium" or "obscura")
NIGHTWALK_BROWSER_ENGINE=chromium

# Request headless mode when creating isolated browser instances (1=headless, 0=default)
NIGHTWALK_BROWSER_HEADLESS=1

# Machine-local declarative targets & flows JSON config (mode 0600, outside Git)
# NIGHTWALK_CONFIG=$XDG_CONFIG_HOME/nightwalk/config.json

# Multimodal Vision QA endpoint (OpenAI-compatible /v1 base URL)
# Leave unset to resolve automatically from $XDG_CONFIG_HOME/local-agents/profiles.json
# NIGHTWALK_VLM_URL=http://127.0.0.1:8010/v1
# NIGHTWALK_VLM_MODEL=vision-model-name
# NIGHTWALK_VLM_API_KEY=
NIGHTWALK_VLM_PROFILE=tactical
NIGHTWALK_VLM_REASONING_EFFORT=medium
NIGHTWALK_VLM_TIMEOUT_SEC=120
NIGHTWALK_VLM_MAX_TOKENS=2048

# Telemetry thresholds
NIGHTWALK_SLOW_ENDPOINT_MS=300
NIGHTWALK_LOOPBACK_ONLY=1

# Persistent state (SQLite dedupe ledger + screenshot artifacts)
# NIGHTWALK_STATE_DIR=$XDG_STATE_HOME/nightwalk
# NIGHTWALK_REPORT_DIR=$HOME/Documents/reports/dogfood

# Optional read-first status panel JSON path ("off" disables)
# NIGHTWALK_PANEL_PATH=$XDG_STATE_HOME/vega/panels/12-dogfood.json

# Deduplicated ticket sink commands ("off" disables ticket filing)
NIGHTWALK_AUTO_FILE_TICKETS=1
NIGHTWALK_TICKET_PRIORITY=P2
NIGHTWALK_TICKET_COOLDOWN_HOURS=72
NIGHTWALK_MAX_TICKETS_PER_RUN=8
# NIGHTWALK_TICKET_LIST_CMD=vega-pulse list --all --json
# NIGHTWALK_TICKET_ADD_CMD=vega-pulse add
