# nightwalk nightly customer-zero dogfooding service (read-only UI QA).
# Generic 12-Factor unit: zero hardcoded usernames or absolute paths.
[Unit]
Description=Nightwalk — Nightly customer-zero interactive dogfooding and Vision QA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_CACHE_HOME=%h/.cache
EnvironmentFile=-%h/.config/nightwalk/env
ExecStart=%h/.local/bin/nightwalk run
